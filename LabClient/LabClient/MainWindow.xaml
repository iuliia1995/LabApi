<Window x:Class="LabClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="LightGray" Margin="10">
            <TextBlock Text="Разделы" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button x:Name="StudentsButton" Content="Студенты" Height="35" Margin="0,5" Click="StudentsButton_Click"/>
            <Button x:Name="BooksButton" Content="Книги" Height="35" Margin="0,5" Click="BooksButton_Click"/>
            <Button x:Name="RequestsButton" Content="Заявки" Height="35" Margin="0,5" Click="RequestsButton_Click"/>
            <Button x:Name="ProductsButton" Content="Товары" Height="35" Margin="0,5" Click="ProductsButton_Click"/>
            <Button x:Name="TasksButton" Content="Задачи" Height="35" Margin="0,5" Click="TasksButton_Click"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="Выберите раздел" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <DataGrid x:Name="DataGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
        </Grid>
    </Grid>
</Window>